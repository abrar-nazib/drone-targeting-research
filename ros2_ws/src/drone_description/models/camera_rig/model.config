<?xml version="1.0"?>
<model>
  <name>camera_rig</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>drone_targeting_research</name>
  </author>
  <description>
    Kinematic stereo + semantic segmentation camera rig for the perception
    phase. No flight dynamics — the model is static and is teleported via
    the world set_pose service. Stereo baseline = 0.10 m, both cameras at
    1280x720 / 30 Hz / 90 deg HFOV. A semantic segmentation camera shares
    the rig's frame.
  </description>
</model>
