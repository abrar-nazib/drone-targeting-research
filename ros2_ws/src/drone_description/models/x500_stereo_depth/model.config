<?xml version="1.0" encoding="UTF-8"?>
<model>
  <name>x500_stereo_depth</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    PX4 x500 quadrotor with a forward-mounted research sensor pod:
    stereo (left+right RGB), co-located depth camera, OakD-Lite mesh
    for the camera body. Fixed-mounted, no gimbal. Topics published
    on /stereo/{left,left/depth,right} so they're easy to pick from
    the gz GUI ImageDisplay plugin.
  </description>
</model>
